# ============================================================
# Hweb 环境变量配置模板
# 复制本文件为 .env 并填入真实密钥：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，请勿提交到版本库
# ============================================================

# ---- 大模型 API（必填）----
# 阶跃星辰 StepFun：https://platform.stepfun.com/ 控制台获取
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# ---- 文本嵌入模型 API（必填）----
# 阿里云百炼 DashScope：https://bailian.console.aliyun.com/ 控制台获取
DASHSCOPE_API_KEY=

# ---- 和风天气 API（可选，不配置则天气功能自动降级）----
# https://console.qweather.com/ 控制台获取；Host 在控制台「设置」中查看
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# ---- 存储路径（可选，一般无需修改）----
# 文件存储路径
DOC_STORE_PATH=./upload_files
# Chroma 向量库持久化路径
CHROMA_PERSIST_PATH=./chroma_db
# SQLite 数据库文件路径
SQLITE_DB_PATH=./chat.db
